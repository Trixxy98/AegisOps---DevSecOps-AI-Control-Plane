{
  "id": null,
  "uid": "aegisops-overview",
  "title": "AegisOps Overview",
  "description": "Implemented API and Worker metrics. Other roadmap panels will be added when their instruments exist.",
  "tags": ["aegisops", "observability"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"aegisops-api\",http_route!~\"/hubs/.*\"}[5m])))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "API 5xx rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{job=\"aegisops-api\",http_route!~\"/hubs/.*\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"aegisops-api\",http_route!~\"/hubs/.*\"}[5m])), 1e-9)",
          "legendFormat": "5xx %",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Worker queue depth (shared queue; max across replicas)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max by (status) (aegisops_jobs_queue_depth{job=\"aegisops-worker\"})",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Worker processed jobs / second",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (status) (rate(aegisops_jobs_processed_total{job=\"aegisops-worker\"}[5m]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    }
  ]
}
