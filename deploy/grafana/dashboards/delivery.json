{
  "id": null,
  "uid": "aegisops-delivery",
  "title": "AegisOps Delivery",
  "description": "Worker deployment job attempts, not deployment outcomes or lead time. Only positive attempt rates are plotted; counter baselines are seeded at zero.",
  "tags": ["aegisops", "delivery"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Deployment job attempts / second by type and persisted job status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "editorMode": "code", "expr": "sum by (type, status) (rate(aegisops_jobs_processed_total{job=\"aegisops-worker\",type=~\"EvaluateDeployment|ExecuteDeployment\"}[5m])) > 0", "legendFormat": "{{type}} {{status}}", "range": true }]
    },
    {
      "id": 2,
      "title": "Deployment job attempt duration p95 by type (not deployment lead time)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [{ "refId": "A", "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, type) (rate(aegisops_jobs_duration_seconds_bucket{job=\"aegisops-worker\",type=~\"EvaluateDeployment|ExecuteDeployment\"}[5m])))", "legendFormat": "{{type}}", "range": true }]
    }
  ]
}
