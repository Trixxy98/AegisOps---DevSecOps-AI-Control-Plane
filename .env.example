POSTGRES_PASSWORD=aegisops_dev
JWT_SIGNING_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes

# Optional DB-backed team webhook secrets. Keep encryption keys out of source control.
# Generate two independent 32-byte keys and base64-encode them in your secret store.
# WEBHOOK_SECRETS_ENABLED=true
# WEBHOOK_SECRETS_CURRENT_KEY_ID=key1
# WEBHOOK_SECRETS_KEY_1=<base64-encoded-32-byte-key>
# WEBHOOK_SECRETS_KEY_2=

# Secret environment variables injected into deployed containers (docs/17 section 5).
# scripts/gen-secrets.sh generates these. Without them, plain variables still work but
# saving a secret variable returns 409 "Secret storage is not configured".
# To rotate: add ENVIRONMENT_SECRETS_KEY_2 (and a matching EnvironmentSecrets__Keys__key2 in
# docker-compose.yml), switch the current key ID, and keep the old key until every secret is re-saved.
# ENVIRONMENT_SECRETS_ENABLED=true
# ENVIRONMENT_SECRETS_CURRENT_KEY_ID=key1
# ENVIRONMENT_SECRETS_KEY_1=<base64-encoded-32-byte-key>
