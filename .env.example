POSTGRES_PASSWORD=aegisops_dev
JWT_SIGNING_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes

# Optional DB-backed team webhook secrets. Keep encryption keys out of source control.
# Generate two independent 32-byte keys and base64-encode them in your secret store.
# WEBHOOK_SECRETS_ENABLED=true
# WEBHOOK_SECRETS_CURRENT_KEY_ID=key1
# WEBHOOK_SECRETS_KEY_1=<base64-encoded-32-byte-key>
# WEBHOOK_SECRETS_KEY_2=

# Secret environment variables injected into deployed containers (docs/17 section 5).
# scripts/gen-secrets.sh generates these. Without them, plain variables still work but
# saving a secret variable returns 409 "Secret storage is not configured".
# To rotate: add ENVIRONMENT_SECRETS_KEY_2 (docker-compose.yml already passes it to api and worker), switch
# the current key ID, and keep the old key until every secret is re-saved (docs/operations.md).
# ENVIRONMENT_SECRETS_ENABLED=true
# ENVIRONMENT_SECRETS_CURRENT_KEY_ID=key1
# ENVIRONMENT_SECRETS_KEY_1=<base64-encoded-32-byte-key>

# Production on one server (docs/deploy-production.md): use scripts/gen-secrets.sh, never this file's
# placeholder values (the API refuses them outside Development). The production api and worker connect as the
# restricted database role aegisops_app (SELECT/INSERT only on audit.*), created by the migrate command with
# APP_DB_PASSWORD; the Development stack ignores it and connects as the owner. An existing .env gets the key with
# scripts/gen-secrets.sh --upgrade (then run migrate once and restart api and worker).
# APP_DB_PASSWORD=<generated by scripts/gen-secrets.sh>
# Then add:
# AEGISOPS_DOMAIN=aegisops.example.com
# ACME_EMAIL=ops@example.com
# AEGISOPS_PROXY_NETWORK=172.16.0.0/12   # only if `docker network inspect aegisops` shows another subnet
# Commands (add -f deploy/docker-compose.tls.yml for HTTPS):
#   docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml run --rm migrate
#   docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml run --rm api bootstrap-admin --email you@example.com
